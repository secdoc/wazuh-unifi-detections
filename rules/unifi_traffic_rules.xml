<group name="unifi-traffic,">
  <rule id="110100" level="0">
    <decoded_as>unifi-traffic</decoded_as>
    <description>UniFi EFG firewall traffic log (grouping).</description>
  </rule>

  <rule id="110101" level="0">
    <if_sid>110100</if_sid>
    <field name="unifi_fw_rule" type="pcre2">-A-</field>
    <description>UniFi EFG: allowed traffic (suppressed).</description>
  </rule>

  <rule id="110102" level="5">
    <if_sid>110100</if_sid>
    <field name="unifi_fw_rule" type="pcre2">-D-|-R-</field>
    <description>UniFi EFG: traffic blocked by firewall rule $(unifi_fw_descr).</description>
    <group>firewall_block,</group>
  </rule>

  <rule id="110103" level="10" frequency="10" timeframe="120">
    <if_matched_sid>110102</if_matched_sid>
    <same_source_ip />
    <description>UniFi EFG: repeated firewall blocks from same source (possible scan).</description>
    <mitre><id>T1046</id></mitre>
  </rule>
</group>
